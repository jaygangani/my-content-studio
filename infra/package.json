{
  "name": "mycontentstudio-web-infra",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all --require-approval never --outputs-file ../cdk-outputs.json && node ../scripts/write-env-deploy.mjs",
    "destroy": "cdk destroy --all"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.180.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.180.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
