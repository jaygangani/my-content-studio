# Prefer: npm run infra:deploy (writes S3_BUCKET / CLOUDFRONT_* from CDK outputs).

# Required for infra:deploy:
CDK_DEFAULT_ACCOUNT=
AWS_REGION=ap-south-1

# Optional custom domain (certificate must be in us-east-1):
# APP_DOMAIN=studio.example.com
# APP_CERTIFICATE_ARN=arn:aws:acm:us-east-1:ACCOUNT:certificate/...

# Filled by infra:deploy:
S3_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=
APP_URL=

# Production backend outputs (written by npm run backend:deploy:prod):
# AMPLIFY_OUTPUTS=outputs/production/amplify_outputs.json

# Optional deploy:
# S3_PREFIX=
# SKIP_BUILD=0
# DRY_RUN=0
# YES=0
